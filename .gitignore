node_modules/
dist/
.env
*.env.local
*.env.production
# Hand-made .env backups (server/.env.bak-YYYYMMDD…). They hold live secrets, so
# they are ignored rather than merely uncommitted — and the orchestrator's
# forbidden-path rail reads `git status --porcelain`, where an untracked
# `.env.bak-*` matched its `\.env` pattern and raised a CRITICAL alert on every
# iteration. Ignoring keeps the secret protected AND the rail meaningful.
.env.bak*
*/.env.bak*
# Production backups of the manifests, kept on the box for rollback only.
package.json.prod-backup-*
package-lock.json.prod-backup-*

# GCP service account key (NEVER commit)
tmcai-key.json

# Google OAuth client secret (NEVER commit)
client_secret_*.json

# Vector store (contains indexed business data)
server/data/vectors.json

# Google Drive tokens
server/.gdrive_token.json

# Logs
*.log
logs/

# Database dumps (never commit)
*.sql.dump
*.dump
tmcai_data.sql

# LibreOffice / Office lock files
.~lock.*#

# Python virtualenv (agent worker local dev)
agents/.venv/
**/__pycache__/
*.pyc

# Python build artifacts (regenerated by pip install -e)
**/*.egg-info/
agents/build/
agents/dist/

# OS files
.DS_Store
Thumbs.db

# PM2 logs
/var/log/tmcai/

# WhatsApp Web.js session cache + auth (device-specific, re-scan QR on new machine)
server/.wwebjs_cache/
server/.wwebjs_auth/
server/whatsapp-sessions/

# Local Claude Code settings (machine-specific)
.claude/

# Reference + documentation folders are kept local only.
# They contain proprietary diagrams, credential reference files, vendor
# specs, and internal architecture notes that shouldn't ship with the
# code. Anything that needs to be public-facing belongs in README files
# inside the relevant code package, not these folders.
reference/
docs/
# Exception: server/docs/ holds the canonical architecture .md that
# downstream views (Operations Manual wiki seed + How Brain Works
# visual page) derive from. Must ship with the deployment artifact.
!server/docs/
!server/docs/**

# Per-tenant Meta WhatsApp session — explicitly extra layer beyond the
# whatsapp-sessions/ rule above; some tooling lives in subdirs.
server/whatsapp-user-sessions/

# Stray local-only working dirs (not part of the project source)
Required\ Architect/

# Tenant phone session data + auth artifacts
**/whatsapp-sessions/
**/whatsapp-user-sessions/

# Retained local history from the removed orch pipeline (kept on disk, never committed)
crs/
logs/

# Owner-owned, never committed (AGENTS.md)
server/docs/nexeo_self_learning&development.md

# Build-output backups. `dist/` is already ignored, but a timestamped copy of it
# is not, so server/dist.bak-20260812-140334 put ~2600 compiled files into Source
# Control and VS Code reported "2664 changes". Nothing references it and
# `npm run build` regenerates dist from source, so a backup of it is never an
# artefact worth versioning — it is only a hazard: one `git add -A` away from a
# 19 MB commit, and AGENTS.md forbids that add for exactly this reason (BLD-001,
# where a directory add committed an owner-owned file).
dist.bak-*/
server/dist.bak-*/

# Editor settings are per-machine, not per-project.
.vscode/

# Harvested production conversations — real message bodies, never committed.
server/docs/orchestrator/state/recent-chats.md
