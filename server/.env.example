# ============================================================
# TMC AI Intelligence — Production Environment Template
# Copy to .env and fill in actual values
# ============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://tmcai_user:YOUR_PASSWORD@127.0.0.1:5432/tmcai"
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=tmcai_user
PG_PASSWORD=YOUR_PASSWORD
PG_DATABASE=tmcai

# ── Server ────────────────────────────────────────────────────
PORT=4002
CLIENT_URL=https://tai.tmcltd.com
NODE_ENV=production

# ── Google OAuth (Drive + Gmail/Calendar) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tai.tmcltd.com/api/auth/google/callback
GOOGLE_INTEGRATION_REDIRECT_URI=https://tai.tmcltd.com/api/integration/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_INDEX_FILE_NAME=TMC_Drive_Index.md

# ── AI Provider Keys (at least GEMINI_API_KEY required) ───────
GEMINI_API_KEY=
GEMINI_API_KEY_EMBED=
GEMINI_API_KEY_PIPELINE=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── GCP (BigQuery + Vertex AI) ───────────────────────────────
GCP_PROJECT_ID=tmcai-491811
GCP_LOCATION=us-central1
BQ_DATASET=tmcai_index
BQ_TABLE=chunks
DATA_SOURCE=bigquery
AI_PROVIDER=gemini
GOOGLE_APPLICATION_CREDENTIALS=/var/www/tmcai/tmcai-key.json

# ── Cache & RAG ───────────────────────────────────────────────
INDEX_REFRESH_INTERVAL_MS=300000
REQUEST_TIMEOUT_MS=150000
RAG_ENABLED=true
RAG_TOP_K=7
RAG_MIN_SCORE=0.3
PII_ENABLED=false

# ── Encryption (MUST be 32+ chars, unique per environment) ───
ENCRYPTION_KEY=

# ── Weather & News ────────────────────────────────────────────
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=

# ── Brain language defaults (per-deployment; per-user pref overrides) ──
# Fallback when a user hasn't set brain_channel.replyLanguage / translateVoiceInput.
# Lets a new client inherit the language behaviour without per-user SQL.
# BRAIN_REPLY_LANGUAGE_DEFAULT: auto | english | urdu | roman_urdu  (unset = auto)
# BRAIN_INPUT_TRANSLATE_DEFAULT: english  (unset = transcribe voice in the spoken language)
BRAIN_REPLY_LANGUAGE_DEFAULT=
BRAIN_INPUT_TRANSLATE_DEFAULT=
