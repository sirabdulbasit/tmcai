  lastUpdated     DateTime @default(now()) @map("last_updated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, userId])
  @@index([clientNumber, status])
  @@index([clientNumber, ownerId])
  @@map("okrs")
}

// ─── Risk Register ────────────────────────────────────────────────

model RiskRegisterItem {
  id           String    @id @default(cuid())
  clientNumber String    @map("client_number") @db.VarChar(20)
  description  String    @db.Text
  category     String    @db.VarChar(30) // financial | operational | compliance | technical | client | employee
  severity     String    @db.VarChar(10) // critical | high | medium | low
  status       String    @default("open") @db.VarChar(20) // open | mitigating | mitigated | closed
  mitigation   String?   @db.Text
  ownerId      Int?      @map("owner_id")
  entityId     String?   @map("entity_id")
  source       String    @db.VarChar(30) // erp | email | chat | known | manual
  sourceRef    String?   @map("source_ref") @db.VarChar(500)
  detectedAt   DateTime  @default(now()) @map("detected_at")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, status])
  @@index([clientNumber, severity])
  @@index([clientNumber, entityId])
