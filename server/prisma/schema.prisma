// ─── Open Items ───────────────────────────────────────────────────

model OpenItem {
  id              String    @id @default(cuid())
  itemNumber      Int       @default(autoincrement()) @map("item_number")
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  entityId        String?   @map("entity_id")
  type            String    @db.VarChar(30) // task | email | delegation | alert | erp | okr | risk
  // HaseebOS v15 §3.2 L2 — 8-value lifecycle enforced by services/itemLifecycle
  status          String    @default("NEW") @db.VarChar(20) // NEW | TRIAGED | IN_PROGRESS | DELEGATED | WAITING_INFO | SNOOZED | INFORMED | CLOSED
  priority        String    @default("medium") @db.VarChar(10) // critical | high | medium | low
  ownerId         Int       @map("owner_id") // FK → User
  delegateeId     Int?      @map("delegatee_id") // FK → User (internal)
  delegateeName   String?   @map("delegatee_name") @db.VarChar(200) // external person name
  delegateeEmail  String?   @map("delegatee_email") @db.VarChar(200)
  dueDate         DateTime? @map("due_date")
  sourceFeed      String?   @map("source_feed") @db.VarChar(30) // gmail | whatsapp | chat | erp | okr | manual
  sourceRef       String?   @map("source_ref") @db.VarChar(500) // thread ID, session ID, etc.
  connectorId     String?   @map("connector_id") // FK → UserConnector
  delegationTrail Json      @default("[]") @map("delegation_trail")
  notes           Json      @default("[]")
  metadata        Json?
  priorityScore   Float?    @map("priority_score")
  idempotencyKey  String?   @unique @map("idempotency_key")
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  // ── HaseebOS v15 (M12) ──
  dedupHash           String?  @map("dedup_hash") @db.VarChar(64) // sha256 over canonical content for dedup
  enrichmentData      Json?    @map("enrichment_data") // classifier output, entity links, features
  shadowScore         Float?   @map("shadow_score") // score from shadow rules (no UI action)
  sourceFeedEventId   String?  @map("source_feed_event_id") // FK → feed_events.id (soft ref)
  archetype           String?  @db.VarChar(30) // reply_needed | delegate | inform_only | schedule_meeting | review_risk | acknowledge
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, userId, status])
  @@index([clientNumber, userId, priority])
  @@index([clientNumber, entityId])
  @@index([priorityScore])
  @@index([clientNumber, dedupHash])
  @@index([sourceFeedEventId])
  @@map("open_items")
}

/**
 * HaseebOS v15 L2+ — OpenItem embeddings for similar-items lookup.
 * Stored as a JSON float array to avoid a pgvector dependency in dev. When
 * pgvector is available, a separate migration can add a `vector(1536)` column
 * + IVFFlat index; the service layer stays backwards-compatible.
 */
model OpenItemEmbedding {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  openItemId   String   @unique @map("open_item_id")
  model        String   @db.VarChar(50)
  dim          Int
  embedding    Json
  textHash     String   @map("text_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientNumber, createdAt])
  @@map("open_item_embeddings")
}

/**
 * HaseebOS v15 L2 — append-only history of status transitions per OpenItem.
 * Written atomically with every status change by lifecycleService. Powers the
 * Steering Wheel timeline view and serves as the audit trail for invalid
 * transition attempts (status from==to, reason='rejected').
 */
model ItemStatusHistory {
  id            Int      @id @default(autoincrement())
  clientNumber  String   @map("client_number") @db.VarChar(20)
  openItemId    String   @map("open_item_id")
  fromStatus    String   @map("from_status") @db.VarChar(20)
  toStatus      String   @map("to_status") @db.VarChar(20)
  outcome       String   @default("accepted") @db.VarChar(20) // accepted | rejected
  reason        String?  @db.VarChar(500)
  actor         String?  @db.VarChar(50) // user:<id> | agent:<name> | system
  traceId       String?  @map("trace_id") @db.VarChar(64)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientNumber, openItemId, createdAt])
  @@index([clientNumber, outcome, createdAt])
  @@map("item_status_history")
}

// ─── Entity Knowledge Graph ───────────────────────────────────────

