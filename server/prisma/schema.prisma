generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ─── Tenants (Multi-tenant root) ───────────────────────────────

model Tenant {
  clientNumber String    @id @map("client_number") @db.VarChar(20)
  name         String    @db.VarChar(200)
  domain       String?   @db.VarChar(100) // e.g. tmc.com
  isActive     Boolean   @default(true) @map("is_active")
  expiry       DateTime? @map("expiry") // Subscription expiry date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  configs        SystemConfig[]
  users          User[]
  clientLicense  ClientLicense?
  documents      Document[]
  chunks         Chunk[]
  conversations  Conversation[]
  messages       Message[]
  auditLogs      AuditLog[]
  scheduledTasks ScheduledTask[]

  @@map("tenants")
}

// ─── Licensing ─────────────────────────────────────────────────

model License {
  id           Int      @id @default(autoincrement())
  roleType     String   @unique @map("role_type") @db.VarChar(20) // admin, standard, basic
  pricePerSeat Decimal  @map("price_per_seat") @db.Decimal(10, 2)
  currency     String   @default("USD") @db.VarChar(5)
  description  String?  @db.VarChar(200)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("licenses")
}

model ClientLicense {
  id            Int      @id @default(autoincrement())
  clientNumber  String   @unique @map("client_number") @db.VarChar(20)
  adminSeats    Int      @default(0) @map("admin_seats") // Admin seat count
  standardSeats Int      @default(0) @map("standard_seats") // Standard seat count
  basicSeats    Int      @default(0) @map("basic_seats") // Basic seat count
  licenseAmount Decimal  @default(0) @map("license_amount") @db.Decimal(12, 2) // Total before discount
  discount      Decimal  @default(0) @map("discount") @db.Decimal(5, 2) // Discount %
  discAmount    Decimal  @default(0) @map("disc_amount") @db.Decimal(12, 2) // Discount amount
  netAmount     Decimal  @default(0) @map("net_amount") @db.Decimal(12, 2) // Final billing
  termAmount    Decimal  @default(0) @map("term_amount") @db.Decimal(12, 2) // Per-period cost
  term          String   @default("M") @db.VarChar(5) // M=monthly, Q=quarterly, Y=yearly
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [clientNumber], references: [clientNumber])

  @@map("client_licenses")
}

// ─── System Configuration (HRAPR pattern) ──────────────────────

model SystemConfig {
  clientNumber String   @map("client_number") @db.VarChar(20)
  key          String   @db.VarChar(50)
  value        String   @db.Text
  isSensitive  Boolean  @default(false) @map("is_sensitive")
  description  String?  @db.VarChar(255)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [clientNumber], references: [clientNumber])

  @@id([clientNumber, key])
  @@map("system_config")
}

// ─── Users ─────────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  clientNumber    String    @map("client_number") @db.VarChar(20)
  empcode         String    @db.VarChar(20)
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(100) // Globally unique across all tenants
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  userType        String    @default("BS") @map("user_type") @db.VarChar(5) // SA, AD, ST, BS
  department      String?   @db.VarChar(50)
  isActive        Boolean   @default(true) @map("is_active")
  inviteToken     String?   @unique @map("invite_token") @db.VarChar(255)
  inviteExpiresAt DateTime? @map("invite_expires_at")
  inviteSentAt    DateTime? @map("invite_sent_at")
  passwordSet     Boolean   @default(false) @map("password_set") // false = needs to set via invite
  lastLoginAt     DateTime? @map("last_login_at")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until")
  jobDescription  String?   @map("job_description") @db.Text
  city            String?   @db.VarChar(100)
  contactNumber   String?   @map("contact_number") @db.VarChar(30)
  aboutMe         String?   @map("about_me") @db.Text
  instructions    String?   @db.Text
  tonePreference  String?   @map("tone_preference") @db.VarChar(30)

  // ── Personal Intelligence (Phase 4 — Envelope Encryption) ──
  encryptedDek String? @map("encrypted_dek") @db.Text // DEK encrypted with MEK (AES-256-GCM). NULL = DEK not yet generated.

  // ── Personal GDrive (Phase 3.1) ─────────────────────────────
  personalDriveFolderId String?   @map("personal_drive_folder_id") @db.VarChar(255) // GDrive folder ID user selected
  personalDriveLastSync DateTime? @map("personal_drive_last_sync") // Last successful sync timestamp

  // ── Email & Calendar Integration (per-user, admin-managed) ──
  integrationProvider     String?   @map("integration_provider") @db.VarChar(20) // 'google' or 'microsoft'
  integrationEmail        String?   @map("integration_email") @db.VarChar(150) // connected email address
  integrationAccessToken  String?   @map("integration_access_token") @db.Text // OAuth access token (encrypted)
  integrationRefreshToken String?   @map("integration_refresh_token") @db.Text // OAuth refresh token (encrypted)
  integrationTokenExpiry  DateTime? @map("integration_token_expiry") // when access token expires
  integrationScopes       String?   @map("integration_scopes") @db.VarChar(200) // 'email,calendar' or 'email' or 'calendar'
  integrationStatus       String?   @map("integration_status") @db.VarChar(20) // 'active', 'expired', 'error'
  integrationError        String?   @map("integration_error") @db.Text // last error message if any
  integrationPermissions  String?   @default("email_read,calendar_read") @map("integration_permissions") @db.Text // comma-separated: email_read,email_write,calendar_read,calendar_write,calendar_delete

  // ── HaseebOS v15 — per-user risk + agent config (M11) ──
  riskTolerance          String? @map("risk_tolerance") @db.VarChar(10) // conservative | balanced | aggressive
  agentConfigOverrides   Json?   @map("agent_config_overrides") // per-user agent tweaks
  notificationPreferences Json?  @map("notification_preferences") // channel prefs, quiet hours
  killSwitchEnabled      Boolean @default(false) @map("kill_switch_enabled") // allow this user to trigger tenant kill switch

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [clientNumber], references: [clientNumber])
  sessions           Session[]
  conversations      Conversation[]
  auditLogs          AuditLog[]
  scheduledTasks     ScheduledTask[]
  personalDocuments  PersonalDocument[]
  whatsappConnection WhatsAppConnection?
  brainUserMessages  BrainUserMessage[]

  @@unique([clientNumber, empcode])
  @@map("users")
}

// ─── Sessions ──────────────────────────────────────────────────

model Session {
  id        Int      @id @default(autoincrement())
  // C2 — sha256(token) hex. Raw token is returned to the client at issue
  // time and never persisted; a read-only DB leak no longer hands over
  // live bearer tokens.
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// ─── Documents & Chunks ────────────────────────────────────────

model Document {
  id             Int       @id @default(autoincrement())
  clientNumber   String    @map("client_number") @db.VarChar(20)
  source         String    @db.VarChar(50)
  sourceId       String?   @map("source_id") @db.VarChar(255)
  title          String    @db.VarChar(255)
  version        String?   @db.VarChar(50)
  department     String?   @db.VarChar(50)
  lastCheckedAt  DateTime? @map("last_checked_at")
  lastModifiedAt DateTime? @map("last_modified_at")
  syncStatus     String    @default("pending") @map("sync_status") @db.VarChar(20)
  contentHash    String?   @map("content_hash") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  archivedAt     DateTime? @map("archived_at")

  tenant Tenant  @relation(fields: [clientNumber], references: [clientNumber])
  chunks Chunk[]

  @@map("documents")
}

model Chunk {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  documentId   Int      @map("document_id")
  content      String   @db.Text
  embedding    Json     @default("[]")
  // M1 — pgvector mirror of `embedding`. Written by the embedding backfill
  // job; queried via raw SQL using `<=>` cosine distance. JSON column is
  // kept until backfill is complete then dropped in a follow-up migration.
  vectorEmbedding Unsupported("vector(768)")? @map("vector_embedding")
  chunkIndex   Int      @map("chunk_index")
  headerPath   String[] @default([]) @map("header_path")
  contentHash  String   @unique @map("content_hash") @db.VarChar(64)
  department   String?  @db.VarChar(50)
  source       String   @db.VarChar(50)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [clientNumber], references: [clientNumber])
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([clientNumber])
  @@index([documentId])
  @@index([contentHash])
  @@index([department])
  @@map("chunks")
}

// ─── Chat History ──────────────────────────────────────────────

model Conversation {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  userId       Int      @map("user_id")
  title        String?  @db.VarChar(255)
  provider     String?  @db.VarChar(20)
  messageCount Int      @default(0) @map("message_count")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [clientNumber], references: [clientNumber])
  user     User      @relation(fields: [userId], references: [id])
  messages Message[]

  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  clientNumber   String   @map("client_number") @db.VarChar(20)
  conversationId Int      @map("conversation_id")
  role           String   @db.VarChar(10)
  content        String   @db.Text
  provider       String?  @db.VarChar(20)
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  responseTimeMs Int?     @map("response_time_ms")
  source         String?  @default("web") @db.VarChar(20) // web | whatsapp | api | agent
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [clientNumber], references: [clientNumber])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ─── User Memory ───────────────────────────────────────────────
// UserMemory model REMOVED — replaced by user_profile_memory (raw SQL, 1 row per user)
// Legacy tables ai_memory, context_memory, user_memory dropped on 2026-03-29

// ─── Audit Log ─────────────────────────────────────────────────

model AuditLog {
  id               Int      @id @default(autoincrement())
  clientNumber     String   @map("client_number") @db.VarChar(20)
  userId           Int?     @map("user_id")
  maskedQuery      String   @map("masked_query") @db.Text
  provider         String   @db.VarChar(20)
  chunksRetrieved  Int      @default(0) @map("chunks_retrieved")
  topScore         Float?   @map("top_score")
  piiEntitiesCount Int      @default(0) @map("pii_entities_count")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  responseTimeMs   Int      @map("response_time_ms")
  intentType       String?  @map("intent_type") @db.VarChar(30)
  source           String?  @default("web") @db.VarChar(20) // web | whatsapp | api | agent
  error            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [clientNumber], references: [clientNumber])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// ─── Personal Data (Phase 3 — GDrive + File Upload) ───────────
// Scoped to userId only — admin queries NEVER touch these tables.

model PersonalDocument {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  source      String   @db.VarChar(20) // 'gdrive' | 'upload'
  externalId  String?  @map("external_id") @db.VarChar(255) // GDrive file ID (null for uploads)
  folderId    String?  @map("folder_id") @db.VarChar(255) // GDrive folder ID (null for uploads)
  fileName    String   @map("file_name") @db.VarChar(255)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  sizeBytes   Int?     @map("size_bytes")
  contentHash String?  @map("content_hash") @db.VarChar(64) // SHA-256 for dedup
  storagePath String?  @map("storage_path") @db.VarChar(500) // GCS path for uploaded files
  parseStatus String   @default("pending") @map("parse_status") @db.VarChar(20) // pending|processing|done|error
  parseError  String?  @map("parse_error") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks PersonalChunk[]

  @@index([userId])
  @@index([userId, source])
  @@index([userId, externalId])
  @@map("personal_documents")
}

model PersonalChunk {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  documentId  Int      @map("document_id")
  content     String   @db.Text
  embedding   Json     @default("[]")
  chunkIndex  Int      @map("chunk_index")
  contentHash String   @map("content_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  document PersonalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([contentHash])
  @@map("personal_chunks")
}

// ─── Phase 5: Organizational Intelligence ──────────────────────

model IndexEvent {
  id           Int       @id @default(autoincrement())
  clientNumber String    @map("client_number") @db.VarChar(20)
  eventType    String    @map("event_type") @db.VarChar(50) // file_changed|data_updated|manual_sync
  source       String?   @db.VarChar(50) // gdrive|bigquery|manual
  sourceId     String?   @map("source_id") @db.VarChar(255) // file_id, table_name, etc.
  status       String    @default("pending") @db.VarChar(20) // pending|processing|done|error
  priority     Int       @default(5) // 1=highest, 10=lowest
  payload      Json      @default("{}")
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")

  @@index([clientNumber, status])
  @@index([status, priority, createdAt])
  @@map("index_events")
}

model ProactiveAlert {
  id           Int       @id @default(autoincrement())
  clientNumber String    @map("client_number") @db.VarChar(20)
  alertType    String    @map("alert_type") @db.VarChar(50) // anomaly|insight|risk|opportunity
  title        String    @db.VarChar(255)
  content      String    @db.Text
  severity     String    @default("info") @db.VarChar(20) // info|warning|critical
  isRead       Boolean   @default(false) @map("is_read")
  notifiedAt   DateTime? @map("notified_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([clientNumber, isRead])
  @@index([clientNumber, createdAt])
  @@map("proactive_alerts")
}

model KnowledgeItem {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  category     String   @db.VarChar(50) // decision|lesson_learned|transcript|procedure
  title        String   @db.VarChar(255)
  content      String   @db.Text
  tags         String[] @default([])
  source       String?  @db.VarChar(50)
  sourceId     String?  @map("source_id") @db.VarChar(255)
  embedding    Json     @default("[]")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber])
  @@index([clientNumber, category])
  @@map("knowledge_items")
}

// ─── Phase 6: Domain Expert Knowledge Base ─────────────────────

model DomainKnowledge {
  id        Int      @id @default(autoincrement())
  region    String   @db.VarChar(20) // pk|ae|ksa|qa|global
  vertical  String   @db.VarChar(30) // manufacturing|petroleum|financial|public_sector|general
  category  String   @db.VarChar(30) // regulatory|industry|procedure|definition
  title     String   @db.VarChar(255)
  content   String   @db.Text
  parentId  Int?     @map("parent_id") // For knowledge graph traversal (recursive CTE)
  tags      String[] @default([])
  source    String?  @db.VarChar(100)
  sourceRef String?  @map("source_ref") @db.VarChar(255)
  embedding Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  parent   DomainKnowledge?  @relation("KnowledgeHierarchy", fields: [parentId], references: [id])
  children DomainKnowledge[] @relation("KnowledgeHierarchy")

  @@index([region, vertical])
  @@index([category])
  @@map("domain_knowledge")
}

// ─── Phase 8: Agentic Capabilities ─────────────────────────────

model AgentAction {
  id               Int       @id @default(autoincrement())
  clientNumber     String    @map("client_number") @db.VarChar(20)
  userId           Int       @map("user_id")
  actionType       String    @map("action_type") @db.VarChar(50) // draft_email|send_email|create_event|update_project|generate_report
  status           String    @default("pending") @db.VarChar(20) // pending|approved|rejected|executing|done|error
  input            Json      @default("{}")
  output           Json?
  requiresApproval Boolean   @default(true) @map("requires_approval")
  approvedBy       Int?      @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  error            String?   @db.Text
  // ── HaseebOS v15 (M13) ──
  riskTier          String?  @map("risk_tier") @db.VarChar(10) // LOW | MEDIUM | HIGH
  undoStatus        String?  @map("undo_status") @db.VarChar(20) // none | undoable | undone | expired
  idempotencyKey    String?  @unique @map("idempotency_key") @db.VarChar(128) // sha256 from actionIdempotencyService
  dependencyGraphId String?  @map("dependency_graph_id") // groups related actions for cascading undo
  executedByAgent   String?  @map("executed_by_agent") @db.VarChar(50) // brain | feed_curator | triage | action_executor | ...
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, userId])
  @@index([status])
  @@index([dependencyGraphId])
  @@index([executedByAgent])
  @@map("agent_actions")
}

// ─── Phase 8.5: Personal Agent Framework ───────────────────────

model Agent {
  id             Int       @id @default(autoincrement())
  clientNumber   String    @map("client_number") @db.VarChar(20)
  userId         Int       @map("user_id")
  name           String    @db.VarChar(100)
  instructions   String    @db.Text
  dataSources    String[]  @default([]) @map("data_sources") // org|personal_drive|uploads
  schedule       String?   @db.VarChar(50) // cron expression
  actions        String[]  @default([]) // allowed action types
  notifyEmail    Boolean   @default(true) @map("notify_email")
  notifyWhatsApp Boolean   @default(false) @map("notify_whatsapp")
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  lastResult     String?   @map("last_result") @db.Text
  lastError      String?   @map("last_error") @db.Text
  nextRunAt      DateTime? @map("next_run_at")
  memoryContext  Json      @default("{}") @map("memory_context") // persistent cross-run memory (max 10KB)
  runCount       Int       @default(0) @map("run_count")
  errorCount     Int       @default(0) @map("error_count") // for circuit breaker
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([clientNumber, isActive])
  @@map("agents")
}

// ─── WhatsApp ───────────────────────────────────────────────────

model WhatsAppConnection {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  phoneNumber String   @map("phone_number") @db.VarChar(30)
  waId        String?  @map("wa_id") @db.VarChar(50) // WhatsApp contact ID
  status      String   @default("active") @db.VarChar(20) // active|inactive
  provider    String   @default("meta") @db.VarChar(20) // meta|twilio
  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model WhatsAppMessage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  direction String   @db.VarChar(10) // inbound|outbound
  content   String   @db.Text
  messageId String?  @map("message_id") @db.VarChar(100) // Meta/Twilio message ID
  status    String   @default("sent") @db.VarChar(20) // sent|delivered|read|failed
  agentId   Int?     @map("agent_id")
  sessionId Int?     @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("whatsapp_messages")
}

model WhatsAppSession {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  conversationHistory Json      @default("[]") @map("conversation_history")
  agentId             Int?      @map("agent_id")
  lastMessageAt       DateTime  @default(now()) @map("last_message_at")
  closedAt            DateTime? @map("closed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("whatsapp_sessions")
}

// ─── Scheduled Tasks ───────────────────────────────────────────

model ScheduledTask {
  id             Int       @id @default(autoincrement())
  clientNumber   String    @map("client_number") @db.VarChar(20)
  userId         Int       @map("user_id")
  title          String    @db.VarChar(200)
  prompt         String    @db.Text
  cronExpression String    @map("cron_expression") @db.VarChar(50)
  provider       String    @default("gemini-flash") @db.VarChar(20)
  notifyEmail    String?   @map("notify_email") @db.VarChar(255)
  notifySelf     Boolean   @default(true) @map("notify_self")
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  lastResult     String?   @map("last_result") @db.Text
  lastError      String?   @map("last_error") @db.Text
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [clientNumber], references: [clientNumber])
  user   User   @relation(fields: [userId], references: [id])

  @@map("scheduled_tasks")
}

// ═══════════════════════════════════════════════════════════════════
// ─── MyOS: Personal Intelligence Operating System ─────────────────
// ═══════════════════════════════════════════════════════════════════

// ─── Connector Registry (platform-level) ──────────────────────────

model ConnectorType {
  id           String   @id @default(cuid())
  slug         String   @unique @db.VarChar(50) // "gmail", "whatsapp", "sap", etc.
  name         String   @db.VarChar(100) // "Gmail", "WhatsApp", "SAP ERP"
  description  String?  @db.VarChar(500)
  category     String   @db.VarChar(30) // email | calendar | tasks | messaging | chat | drive | social | meetings | notes | data_warehouse | spreadsheets | project_mgmt | erp | crm | hr | intelligence | support | dev | kb | custom
  scope        String   @db.VarChar(20) // "personal" | "organizational"
  authMethod   String   @map("auth_method") @db.VarChar(30) // oauth2 | api_key | webhook | credentials | bot_token | service_account | none
  configSchema Json     @default("{}") @map("config_schema") // JSON Schema for setup form fields
  capabilities Json     @default("[]") // ["read", "write"]
  icon         String?  @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenantConfigs  TenantConnectorConfig[]
  userConnectors UserConnector[]

  @@map("connector_types")
}

// ─── Tenant Connector Config (admin-level) ────────────────────────

model TenantConnectorConfig {
  id              String    @id @default(cuid())
  clientNumber    String    @map("client_number") @db.VarChar(20)
  connectorTypeId String    @map("connector_type_id")
  scope           String    @db.VarChar(20) // "personal" | "organizational"
  isEnabled       Boolean   @default(false) @map("is_enabled") // for personal: can users use this?
  config          Json? // for org: admin-provided credentials/endpoints (encrypted)
  syncSchedule    String?   @map("sync_schedule") @db.VarChar(50) // cron expression for org connectors
  lastSyncAt      DateTime? @map("last_sync_at")
  syncStatus      String?   @map("sync_status") @db.VarChar(20) // idle | syncing | error
  syncError       String?   @map("sync_error") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  connectorType ConnectorType @relation(fields: [connectorTypeId], references: [id])

  @@unique([clientNumber, connectorTypeId])
  @@index([clientNumber])
  @@map("tenant_connector_configs")
}

// ─── User Connector (personal connections) ────────────────────────

model UserConnector {
  id              String    @id @default(cuid())
  userId          Int       @map("user_id")
  clientNumber    String    @map("client_number") @db.VarChar(20)
  connectorTypeId String    @map("connector_type_id")
  config          Json? // encrypted OAuth tokens, phone number, etc.
  status          String    @default("disconnected") @db.VarChar(20) // connected | disconnected | expired | error
  lastSyncAt      DateTime? @map("last_sync_at")
  syncStatus      String?   @map("sync_status") @db.VarChar(20) // idle | syncing | error
  errorMessage    String?   @map("error_message") @db.Text
  metadata        Json? // connector-specific state
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  connectorType ConnectorType @relation(fields: [connectorTypeId], references: [id])

  @@unique([userId, connectorTypeId])
  @@index([clientNumber, userId])
  @@map("user_connectors")
}

// ─── Open Items ───────────────────────────────────────────────────

model OpenItem {
  id              String    @id @default(cuid())
  itemNumber      Int       @default(autoincrement()) @map("item_number")
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  entityId        String?   @map("entity_id")
  type            String    @db.VarChar(30) // task | email | delegation | alert | erp | okr | risk
  // HaseebOS v15 §3.2 L2 — 8-value lifecycle enforced by services/itemLifecycle
  status          String    @default("NEW") @db.VarChar(20) // NEW | TRIAGED | IN_PROGRESS | DELEGATED | WAITING_INFO | SNOOZED | INFORMED | CLOSED
  priority        String    @default("medium") @db.VarChar(10) // critical | high | medium | low
  ownerId         Int       @map("owner_id") // FK → User
  delegateeId     Int?      @map("delegatee_id") // FK → User (internal)
  delegateeName   String?   @map("delegatee_name") @db.VarChar(200) // external person name
  delegateeEmail  String?   @map("delegatee_email") @db.VarChar(200)
  dueDate         DateTime? @map("due_date")
  sourceFeed      String?   @map("source_feed") @db.VarChar(30) // gmail | whatsapp | chat | erp | okr | manual
  sourceRef       String?   @map("source_ref") @db.VarChar(500) // thread ID, session ID, etc.
  connectorId     String?   @map("connector_id") // FK → UserConnector
  delegationTrail Json      @default("[]") @map("delegation_trail")
  notes           Json      @default("[]")
  metadata        Json?
  priorityScore   Float?    @map("priority_score")
  idempotencyKey  String?   @unique @map("idempotency_key")
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  // ── HaseebOS v15 (M12) ──
  dedupHash           String?  @map("dedup_hash") @db.VarChar(64) // sha256 over canonical content for dedup
  enrichmentData      Json?    @map("enrichment_data") // classifier output, entity links, features
  shadowScore         Float?   @map("shadow_score") // score from shadow rules (no UI action)
  sourceFeedEventId   String?  @map("source_feed_event_id") // FK → feed_events.id (soft ref)
  archetype           String?  @db.VarChar(30) // reply_needed | delegate | inform_only | schedule_meeting | review_risk | acknowledge
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, userId, status])
  @@index([clientNumber, userId, priority])
  @@index([clientNumber, entityId])
  @@index([priorityScore])
  @@index([clientNumber, dedupHash])
  @@index([sourceFeedEventId])
  @@map("open_items")
}

/**
 * HaseebOS v15 L2+ — OpenItem embeddings for similar-items lookup.
 * Stored as a JSON float array to avoid a pgvector dependency in dev. When
 * pgvector is available, a separate migration can add a `vector(1536)` column
 * + IVFFlat index; the service layer stays backwards-compatible.
 */
model OpenItemEmbedding {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  openItemId   String   @unique @map("open_item_id")
  model        String   @db.VarChar(50)
  dim          Int
  embedding    Json
  textHash     String   @map("text_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientNumber, createdAt])
  @@map("open_item_embeddings")
}

/**
 * HaseebOS v15 L2 — append-only history of status transitions per OpenItem.
 * Written atomically with every status change by lifecycleService. Powers the
 * Steering Wheel timeline view and serves as the audit trail for invalid
 * transition attempts (status from==to, reason='rejected').
 */
model ItemStatusHistory {
  id            Int      @id @default(autoincrement())
  clientNumber  String   @map("client_number") @db.VarChar(20)
  openItemId    String   @map("open_item_id")
  fromStatus    String   @map("from_status") @db.VarChar(20)
  toStatus      String   @map("to_status") @db.VarChar(20)
  outcome       String   @default("accepted") @db.VarChar(20) // accepted | rejected
  reason        String?  @db.VarChar(500)
  actor         String?  @db.VarChar(50) // user:<id> | agent:<name> | system
  traceId       String?  @map("trace_id") @db.VarChar(64)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientNumber, openItemId, createdAt])
  @@index([clientNumber, outcome, createdAt])
  @@map("item_status_history")
}

// ─── MyOS Wiki (Memex layer) ──────────────────────────────────────
// Per-user, multi-tenant wiki pages. Backing storage can be Notion (when the
// user has connected it) or Postgres markdown (fallback). All tables are scoped
// by (client_number, user_id) — no cross-user reads ever.

model WikiPage {
  id              String    @id @default(cuid()) // Notion page ID if notion-backed, cuid otherwise
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  pageType        String    @map("page_type") @db.VarChar(30) // entity | concept | decision | pattern | meeting | project | source_summary
  title           String    @db.VarChar(300)
  notionDbId      String?   @map("notion_db_id") @db.VarChar(50) // which Notion DB; null if postgres-backed
  storage         String    @db.VarChar(20) // 'notion' | 'postgres'
  bodyMarkdown    String?   @map("body_markdown") @db.Text // populated when storage='postgres'
  inboundLinks    Int       @default(0) @map("inbound_links")
  outboundLinks   Int       @default(0) @map("outbound_links")
  sourceCount     Int       @default(0) @map("source_count")
  status          String    @default("active") @db.VarChar(20) // active | orphan | stale | contradicted | draft
  confidence      Float?
  metadata        Json?
  lastUpdatedBy   String?   @map("last_updated_by") @db.VarChar(50) // wiki_scribe | user:<id> | lint
  lastUpdatedAt   DateTime  @default(now()) @map("last_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Vector retrieval (pgvector). `embedding` itself is vector(768) in
  // Postgres — Prisma has no native vector type so we mark it Unsupported
  // and write via raw SQL inside wikiEmbeddingService. The three
  // bookkeeping columns ride along so we can tell when the embedding is
  // stale or which model produced it.
  embedding           Unsupported("vector(768)")? @map("embedding")
  embeddingModel      String?                     @map("embedding_model") @db.VarChar(40)
  embeddedAt          DateTime?                   @map("embedded_at")
  embeddingTextHash   String?                     @map("embedding_text_hash") @db.VarChar(64)

  sources         WikiPageSource[]
  outboundEdges   WikiPageLink[]   @relation("from_page")
  inboundEdges    WikiPageLink[]   @relation("to_page")

  @@unique([clientNumber, userId, pageType, title], name: "wiki_pages_user_title_idx")
  @@index([clientNumber, userId, pageType])
  @@index([clientNumber, userId, status])
  @@map("wiki_pages")
}

// Lineage: which raw sources, decisions, or open items contributed to this page.
model WikiPageSource {
  id              Int       @id @default(autoincrement())
  wikiPageId      String    @map("wiki_page_id")
  feedEventId     String?   @map("feed_event_id")
  decisionLogId   String?   @map("decision_log_id")
  openItemId      String?   @map("open_item_id")
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  citedAt         DateTime  @default(now()) @map("cited_at")

  wikiPage        WikiPage  @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)

  @@index([wikiPageId])
  @@index([clientNumber, userId, citedAt])
  @@map("wiki_page_sources")
}

// Cross-reference graph between pages in the same user's wiki.
model WikiPageLink {
  id              Int       @id @default(autoincrement())
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  fromPageId      String    @map("from_page_id")
  toPageId        String    @map("to_page_id")
  linkType        String?   @map("link_type") @db.VarChar(30) // related | supersedes | contradicts | parent | child
  createdAt       DateTime  @default(now()) @map("created_at")

  fromPage        WikiPage  @relation("from_page", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage          WikiPage  @relation("to_page", fields: [toPageId], references: [id], onDelete: Cascade)

  @@unique([fromPageId, toPageId, linkType])
  @@index([clientNumber, userId])
  @@map("wiki_page_links")
}

// ─── Entity Knowledge Graph ───────────────────────────────────────

model Entity {
  id                   String    @id @default(cuid())
  entityType           String    @map("entity_type") @db.VarChar(30) // contact | account | project | opportunity | risk | okr
  name                 String    @db.VarChar(300)
  email                String?   @db.VarChar(200)
  phone                String?   @db.VarChar(50)
  company              String?   @db.VarChar(300)
  role                 String?   @db.VarChar(200)
  metadata             Json?
  sentimentScore       Float?    @map("sentiment_score")
  relationshipStrength Float?    @map("relationship_strength")
  lastInteraction      DateTime? @map("last_interaction")
  clientNumber         String    @map("client_number") @db.VarChar(20)
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  linksFrom EntityLink[] @relation("entity_from")
  linksTo   EntityLink[] @relation("entity_to")

  @@unique([clientNumber, entityType, email])
  @@index([clientNumber, entityType])
  @@index([clientNumber, name])
  @@map("entities")
}

model EntityLink {
  id             String   @id @default(cuid())
  entityId       String   @map("entity_id")
  linkedEntityId String   @map("linked_entity_id")
  linkType       String   @map("link_type") @db.VarChar(30) // works_at | manages | owns | sponsors | reports_to
  clientNumber   String   @map("client_number") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  entity       Entity @relation("entity_from", fields: [entityId], references: [id])
  linkedEntity Entity @relation("entity_to", fields: [linkedEntityId], references: [id])

  @@unique([entityId, linkedEntityId, linkType])
  @@index([clientNumber])
  @@map("entity_links")
}

// ─── Brain Configuration (per-user) ──────────────────────────────

model BrainConfig {
  id              String   @id @default(cuid())
  userId          Int      @unique @map("user_id")
  clientNumber    String   @map("client_number") @db.VarChar(20)
  masterContext   String?  @map("master_context") @db.Text // user's self-described role, team, responsibilities
  delegationRules Json     @default("[]") @map("delegation_rules")
  escalationRules Json     @default("[]") @map("escalation_rules")
  privacyRules    Json     @default("[]") @map("privacy_rules")
  feedSettings    Json     @default("{}") @map("feed_settings")
  briefingConfig  Json     @default("{}") @map("briefing_config")
  alertThresholds Json     @default("{}") @map("alert_thresholds")
  automationLevel     String   @default("drafts_only") @map("automation_level") @db.VarChar(20) // observe_only | drafts_only | supervised | full_auto
  confirmedPatterns   Json     @default("[]") @map("confirmed_patterns")
  revokedPatterns     Json     @default("[]") @map("revoked_patterns")
  thoughtPipelineConfig Json   @default("{}") @map("thought_pipeline_config")
  // Per-user risk-radar config (signals, thresholds, schedule). Empty =
  // use defaults from riskRadarService. Editable via brain config routes.
  riskRadarConfig       Json   @default("{}") @map("risk_radar_config")
  // Per-user web-push preferences: enabled toggle, per-event-type
  // settings, quiet hours, rate limits. Defaults applied in pushService.
  pushPrefs             Json   @default("{}") @map("push_prefs")
  // Brain Engine fields (v2 spec)
  engineSchedule      String?  @map("engine_schedule") @db.VarChar(50)  // cron expression, null = on demand only, default "0 3 * * *"
  engineTimezone      String   @default("Asia/Karachi") @map("engine_timezone") @db.VarChar(50)
  lastEngineRun       DateTime? @map("last_engine_run")
  nextEngineRun       DateTime? @map("next_engine_run")
  briefDeliveryTime   String?  @map("brief_delivery_time") @db.VarChar(10) // HH:MM format, null = on demand only
  engineRunning       Boolean  @default(false) @map("engine_running")    // mutex lock
  isActive            Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber])
  @@map("brain_configs")
}

// ─── Rule-Engine Gate ─────────────────────────────────────────────
// Deterministic pre-LLM filter. Three layers — system / tenant / user.
// User > tenant > system. Predicate + action are JSON DSL; see
// ruleEngineService.ts for shape and examples.

model GateRule {
  id                  Int      @id @default(autoincrement())
  scope               String   @db.VarChar(10) // system | tenant | user
  clientNumber        String?  @map("client_number") @db.VarChar(20)
  userId              Int?     @map("user_id")
  ruleKey             String?  @map("rule_key") @db.VarChar(80)
  name                String   @db.VarChar(200)
  description         String?  @db.Text
  predicate           Json
  action              Json
  priority            Int      @default(100)
  enabled             Boolean  @default(true)
  fireCount           Int      @default(0) @map("fire_count")
  lastFiredAt         DateTime? @map("last_fired_at")
  createdByUserId     Int?     @map("created_by_user_id")
  updatedByUserId     Int?     @map("updated_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, scope, enabled, priority], map: "gate_rules_lookup_idx")
  @@index([userId, enabled, priority], map: "gate_rules_user_idx")
  @@index([ruleKey], map: "gate_rules_key_idx")
  @@map("gate_rules")
}

model GateRuleOverride {
  id            Int      @id @default(autoincrement())
  ruleKey       String   @map("rule_key") @db.VarChar(80)
  scope         String   @db.VarChar(10) // tenant | user
  clientNumber  String   @map("client_number") @db.VarChar(20)
  userId        Int?     @map("user_id")
  disabled      Boolean  @default(true)
  reason        String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([ruleKey, scope, clientNumber, userId], map: "gate_rule_overrides_unique")
  @@index([clientNumber, scope, disabled], map: "gate_rule_overrides_lookup_idx")
  @@map("gate_rule_overrides")
}

// ─── Risk Rules ────────────────────────────────────────────────────
// User-defined rules that drive Risk Radar flags. Predicate DSL is
// identical to gate_rules; the source field decides which table the
// executor scans. Three scopes (system/tenant/user) with the same
// override pattern as gate_rules.

model RiskRule {
  id                 Int      @id @default(autoincrement())
  scope              String   @db.VarChar(10) // system | tenant | user
  clientNumber       String?  @map("client_number") @db.VarChar(20)
  userId             Int?     @map("user_id")
  ruleKey            String?  @map("rule_key") @db.VarChar(80)
  name               String   @db.VarChar(200)
  description        String?  @db.Text
  source             String   @db.VarChar(20) // feed_event | open_item | wiki_page
  lookbackHours      Int?     @default(24) @map("lookback_hours")
  predicate          Json
  severity           String   @default("medium") @db.VarChar(10)
  titleTemplate      String?  @map("title_template") @db.Text
  reasonTemplate     String?  @map("reason_template") @db.Text
  suggestedAction    String?  @map("suggested_action") @db.Text
  enabled            Boolean  @default(true)
  fireCount          Int      @default(0) @map("fire_count")
  lastFiredAt        DateTime? @map("last_fired_at")
  createdByUserId    Int?     @map("created_by_user_id")
  updatedByUserId    Int?     @map("updated_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, scope, enabled], map: "risk_rules_lookup_idx")
  @@index([userId, enabled], map: "risk_rules_user_idx")
  @@index([ruleKey], map: "risk_rules_key_idx")
  @@map("risk_rules")
}

model RiskRuleOverride {
  id            Int      @id @default(autoincrement())
  ruleKey       String   @map("rule_key") @db.VarChar(80)
  scope         String   @db.VarChar(10) // tenant | user
  clientNumber  String   @map("client_number") @db.VarChar(20)
  userId        Int?     @map("user_id")
  disabled      Boolean  @default(true)
  reason        String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([ruleKey, scope, clientNumber, userId], map: "risk_rule_overrides_unique")
  @@index([clientNumber, scope, disabled], map: "risk_rule_overrides_lookup_idx")
  @@map("risk_rule_overrides")
}

model GateRuleFiring {
  id            BigInt   @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  ruleKey       String?  @map("rule_key") @db.VarChar(80)
  ruleName      String?  @map("rule_name") @db.VarChar(200)
  ruleScope     String?  @map("rule_scope") @db.VarChar(10)
  clientNumber  String   @map("client_number") @db.VarChar(20)
  userId        Int?     @map("user_id")
  feedEventId   String?  @map("feed_event_id")
  decision      String   @db.VarChar(20)
  firedAt       DateTime @default(now()) @map("fired_at")

  @@index([clientNumber, firedAt(sort: Desc)], map: "gate_rule_firings_recent_idx")
  @@index([ruleId, firedAt(sort: Desc)], map: "gate_rule_firings_rule_idx")
  @@map("gate_rule_firings")
}

// ─── Web Push (subscriptions + approval tokens) ──────────────────
// Per-device push subscription registry. One user can have many
// devices; we dedup on (user_id, endpoint) so re-registering the same
// browser updates rather than duplicates.

model PushSubscription {
  id             Int       @id @default(autoincrement())
  clientNumber   String    @map("client_number") @db.VarChar(20)
  userId         Int       @map("user_id")
  endpoint       String    @db.Text
  p256dhKey      String    @map("p256dh_key") @db.Text
  authKey        String    @map("auth_key") @db.Text
  deviceLabel    String?   @map("device_label") @db.VarChar(120)
  userAgent      String?   @map("user_agent") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  lastPushAt     DateTime? @map("last_push_at")
  lastError      String?   @map("last_error") @db.Text
  failureCount   Int       @default(0) @map("failure_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, endpoint], map: "push_subscriptions_user_endpoint_unique")
  @@index([clientNumber, userId, isActive], map: "push_subscriptions_user_active_idx")
  @@map("push_subscriptions")
}

// Short-lived signed tokens used by the "Approve" / "Reject" buttons in
// push notifications. Token sent to the device is a random 32-byte
// b64url string; only its SHA-256 hash is stored. Single-use, scoped
// to one (action_id, user_id, intent) tuple.

model ApprovalToken {
  id            Int       @id @default(autoincrement())
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  clientNumber  String    @map("client_number") @db.VarChar(20)
  userId        Int       @map("user_id")
  actionId      Int       @map("action_id")
  intent        String    @db.VarChar(20) // approve | reject | view
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  consumedByIp  String?   @map("consumed_by_ip") @db.VarChar(50)
  consumedVia   String?   @map("consumed_via") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([actionId], map: "approval_tokens_action_idx")
  @@map("approval_tokens")
}

// ─── LLM Spend (cost-dashboard time series) ──────────────────────
// One row per LLM call. The cost dashboard reads from here to render
// timelines, top-N breakdowns, and anomaly signals. Cross-linked to
// brain_docs.id when the call produced a typed Doc.

model LlmSpend {
  id            BigInt    @id @default(autoincrement())
  clientNumber  String    @map("client_number") @db.VarChar(20)
  userId        Int?      @map("user_id")
  provider      String    @db.VarChar(40)
  model         String?   @db.VarChar(80)
  purpose       String?   @db.VarChar(60)
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  estUsd        Decimal   @default(0) @map("est_usd") @db.Decimal(10, 6)
  durationMs    Int?      @map("duration_ms")
  success       Boolean   @default(true)
  error         String?   @db.Text
  brainDocId    String?   @map("brain_doc_id")
  feedEventId   String?   @map("feed_event_id")
  requestId     String?   @map("request_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([clientNumber, createdAt(sort: Desc)], map: "llm_spend_client_recent_idx")
  @@index([clientNumber, userId, createdAt(sort: Desc)], map: "llm_spend_user_recent_idx")
  @@index([clientNumber, purpose, createdAt(sort: Desc)], map: "llm_spend_purpose_idx")
  @@index([clientNumber, provider, createdAt(sort: Desc)], map: "llm_spend_provider_idx")
  @@index([brainDocId], map: "llm_spend_brain_doc_idx")
  @@map("llm_spend")
}

// ─── Brain Docs (typed, versioned, replayable Brain outputs) ──────
// Canonical Brain-output store. Every Brain reasoning pass writes one
// row here keyed by (client_number, user_id, doc_type, version). The
// `output` JSON is the structured payload; `prose` is the optional
// rendered prose; `input_summary` + `inputs_hash` enable replay and
// cache-hit detection. Specialized projections (risk_flag_docs, etc.)
// can reference back via `projectionId`.

model BrainDoc {
  id              String    @id
  clientNumber    String    @map("client_number") @db.VarChar(20)
  userId          Int       @map("user_id")
  docType         String    @map("doc_type") @db.VarChar(40)
  version         Int       @default(1)
  status          String    @default("active") @db.VarChar(20)
  inputsHash      String?   @map("inputs_hash") @db.VarChar(64)
  inputSummary    Json      @default("{}") @map("input_summary")
  sourceEventIds  String[]  @default([]) @map("source_event_ids")
  output          Json      @default("{}")
  prose           String?   @db.Text
  summary         String?   @db.Text
  model           String?   @db.VarChar(50)
  tokensInput     Int?      @map("tokens_input")
  tokensOutput    Int?      @map("tokens_output")
  generationMs    Int?      @map("generation_ms")
  error           String?   @db.Text
  supersededById  String?   @map("superseded_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  projectionId    String?   @map("projection_id")

  supersededBy    BrainDoc? @relation("BrainDocSupersedes", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  supersedes      BrainDoc[] @relation("BrainDocSupersedes")

  @@unique([clientNumber, userId, docType, version], map: "brain_docs_logical_unique")
  @@index([clientNumber, userId, docType, createdAt(sort: Desc)], map: "brain_docs_user_type_recent_idx")
  @@index([clientNumber, status, createdAt(sort: Desc)], map: "brain_docs_active_idx")
  @@index([clientNumber, userId, docType, inputsHash], map: "brain_docs_inputs_hash_idx")
  @@map("brain_docs")
}

// ─── Risk Flag Doc ────────────────────────────────────────────────
// One row per (client_number, user_id, run_date). Output of the risk
// radar's daily aggregator: ranked flags, narrative, source signals.
// Stable id `risk:<client>:<user>:<YYYY-MM-DD>` so reruns overwrite.

model RiskFlagDoc {
  id                  String   @id
  clientNumber        String   @map("client_number") @db.VarChar(20)
  userId              Int      @map("user_id")
  runDate             DateTime @map("run_date") @db.Date
  generatedAt         DateTime @default(now()) @map("generated_at")
  flags               Json     @default("[]")
  narrative           String?  @db.Text
  summary             String?  @db.Text
  flagCount           Int      @default(0) @map("flag_count")
  highSeverityCount   Int      @default(0) @map("high_severity_count")
  sourceSignals       Json     @default("{}") @map("source_signals")
  model               String?  @db.VarChar(50)
  tokensInput         Int?     @map("tokens_input")
  tokensOutput        Int?     @map("tokens_output")
  status              String   @default("active") @db.VarChar(20)
  error               String?  @db.Text

  @@unique([clientNumber, userId, runDate], map: "risk_flag_docs_run_date_unique")
  @@index([clientNumber, userId, runDate(sort: Desc)], map: "risk_flag_docs_user_recent_idx")
  @@index([clientNumber, status, generatedAt(sort: Desc)], map: "risk_flag_docs_active_idx")
  @@map("risk_flag_docs")
}

// ─── Delegation Matrix ─────────────────────────────────────────────
// Per-tenant "who owns what business area" map. Loaded into every Brain
// system prompt so routing decisions are deterministic lookups instead of
// LLM inference. Editable only by tenant ADMIN/SA. Compliments per-user
// `BrainConfig.delegationRules` (which encodes type→action imperatives).

model DelegationMatrix {
  id                Int      @id @default(autoincrement())
  clientNumber      String   @map("client_number") @db.VarChar(20)
  area              String   @db.VarChar(100)
  ownerUserId       Int?     @map("owner_user_id")
  ownerName         String   @map("owner_name") @db.VarChar(200)
  ownerEmail        String?  @map("owner_email") @db.VarChar(200)
  ownerRole         String?  @map("owner_role") @db.VarChar(100)
  escalateToName    String?  @map("escalate_to_name") @db.VarChar(200)
  escalateToEmail   String?  @map("escalate_to_email") @db.VarChar(200)
  notes             String?  @db.Text
  effectiveFrom     DateTime? @map("effective_from") @db.Date
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  createdByUserId   Int?     @map("created_by_user_id")
  updatedByUserId   Int?     @map("updated_by_user_id")

  @@unique([clientNumber, area], map: "delegation_matrix_area_unique")
  @@index([clientNumber, isActive], map: "delegation_matrix_active_idx")
  @@map("delegation_matrix")
}

model DelegationMatrixHistory {
  id              Int      @id @default(autoincrement())
  clientNumber    String   @map("client_number") @db.VarChar(20)
  area            String   @db.VarChar(100)
  operation       String   @db.VarChar(20) // insert | update | deactivate | delete
  snapshot        Json
  changedByUserId Int?     @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")

  @@index([clientNumber, area, changedAt(sort: Desc)], map: "delegation_matrix_history_client_idx")
  @@map("delegation_matrix_history")
}

// ─── Decision Log ─────────────────────────────────────────────────

model DecisionLog {
  id              String   @id @default(cuid())
  userId          Int      @map("user_id")
  clientNumber    String   @map("client_number") @db.VarChar(20)
  sessionType     String   @map("session_type") @db.VarChar(30) // morning_briefing | intraday | auto_action
  itemType        String   @map("item_type") @db.VarChar(30) // email | whatsapp | task | calendar | erp | okr | manual
  entityId        String?  @map("entity_id")
  connectorSlug   String?  @map("connector_slug") @db.VarChar(50)
  suggestedAction String?  @map("suggested_action") @db.Text
  userDecision    String   @map("user_decision") @db.VarChar(20) // approved | overrode | delegated | snoozed | dismissed
  actionTaken     String?  @map("action_taken") @db.Text
  isMatch         Boolean  @map("is_match") // true = accepted AI suggestion
  overrideReason  String?  @map("override_reason") @db.Text
  responseTimeMs  Int?     @map("response_time_ms")
  outcome         String?  @db.VarChar(20) // positive | negative | neutral
  openItemId      String?  @map("open_item_id")
  // ── HaseebOS v15 (M14) ──
  confidenceScore Float?   @map("confidence_score") // agent's own confidence in suggestion
  riskTier        String?  @map("risk_tier") @db.VarChar(10) // LOW | MEDIUM | HIGH
  inputSummary    String?  @map("input_summary") @db.Text
  outputSummary   String?  @map("output_summary") @db.Text
  durationMs      Int?     @map("duration_ms") // end-to-end decision latency
  traceId         String?  @map("trace_id") @db.VarChar(64) // Global Trace ID across Pub/Sub
  agentId         String?  @map("agent_id") @db.VarChar(50) // which of the 7 agents made this decision
  // MyOS — canonical signature for scoring. SHA-256 over
  // (user_id, item_type, action_archetype, sender_domain). Pattern counts
  // are COUNT GROUP BY dedup_hash; when a hash crosses threshold + agreement,
  // rule miner promotes it to a shadow_rule.
  dedupHash       String?  @map("dedup_hash") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, clientNumber])
  @@index([clientNumber, createdAt])
  @@index([userId, itemType, isMatch])
  @@index([traceId])
  @@index([clientNumber, riskTier])
  @@index([clientNumber, userId, dedupHash])
  @@map("decision_logs")
}

model DelegationLog {
  id               String   @id @default(cuid())
  clientNumber     String   @map("client_number") @db.VarChar(20)
  userId           Int      @map("user_id") // the delegator (MD)
  delegateeUserId  Int?     @map("delegatee_user_id") // internal TMC user
  delegateeEmail   String?  @map("delegatee_email") @db.VarChar(200)
  delegateeName    String?  @map("delegatee_name") @db.VarChar(200)
  itemType         String   @map("item_type") @db.VarChar(30) // email | whatsapp | task | meeting
  taskArchetype    String?  @map("task_archetype") @db.VarChar(40)
  entityId         String?  @map("entity_id")
  sourceRef        String?  @map("source_ref") @db.VarChar(500)
  senderEmail      String?  @map("sender_email") @db.VarChar(200)
  senderDomain     String?  @map("sender_domain") @db.VarChar(100)
  subject          String?  @db.Text
  briefNote        String?  @map("brief_note") @db.Text
  delegatedBy      String   @default("user") @map("delegated_by") @db.VarChar(20) // user | brain
  confidenceScore  Float?   @map("confidence_score")
  agentId          String?  @map("agent_id") @db.VarChar(50)
  traceId          String?  @map("trace_id") @db.VarChar(64)
  dedupHash        String   @map("dedup_hash") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([clientNumber, userId, createdAt])
  @@index([clientNumber, userId, dedupHash])
  @@index([clientNumber, userId, taskArchetype, createdAt])
  @@map("delegation_logs")
}

model UserPrompt {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  userId       Int      @map("user_id")
  scope        String   @default("global") @db.VarChar(20) // triage | draft_reply | delegation | global
  text         String   @db.Text
