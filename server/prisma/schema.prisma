}

// ─── Action Idempotency Log ──────────────────────────────────────

model ActionIdempotencyLog {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @map("idempotency_key")
  clientNumber   String   @map("client_number") @db.VarChar(20)
  userId         Int      @map("user_id")
  actionType     String   @map("action_type") @db.VarChar(30)
  result         Json
  executedAt     DateTime @default(now()) @map("executed_at")
  expiresAt      DateTime @map("expires_at")

  @@index([clientNumber, userId])
  @@index([expiresAt])
  @@map("action_idempotency_logs")
}

// ═══════════════════════════════════════════════════════════════════
// HaseebOS v15 — Phase 2 schema additions (M1–M10)
// See docs/vscode-analysis/HASEEBOS_V15_IMPLEMENTATION_PLAN.md §5
// ═══════════════════════════════════════════════════════════════════

// ─── M1: Feed Events (immutable raw capture) ────────────────────
model FeedEvent {
  id            String   @id @default(cuid())
  clientNumber  String   @map("client_number") @db.VarChar(20)
  sourceType    String   @map("source_type") @db.VarChar(30) // gmail | whatsapp | gchat | gcal | gtasks
  sourceId      String   @map("source_id") @db.VarChar(500) // external id (thread, message, event)
  contentHash   String   @map("content_hash") @db.VarChar(64) // sha256 for dedup
  rawPayload    Json     @map("raw_payload")
  status        String   @default("new") @db.VarChar(20) // new | processed | dlq | skipped
  traceId       String?  @map("trace_id") @db.VarChar(64)
  // HaseebOS v15 §3.2 F-4 — canonical event_type and sender fields promoted
  // out of rawPayload so Triage Analyst + Steering can index + filter on them.
  eventType     String?  @map("event_type") @db.VarChar(30) // message_received | meeting_invite | task_assigned | …
  senderId      String?  @map("sender_id") @db.VarChar(200)
  senderEmail   String?  @map("sender_email") @db.VarChar(200)
  senderName    String?  @map("sender_name") @db.VarChar(200)
  senderPhone   String?  @map("sender_phone") @db.VarChar(30)
  // L1.3/L1.4 — publish state for pre-publish SETNX gate + catch-up worker
  publishedMessageId String? @map("published_message_id") @db.VarChar(100)
  publishedAt        DateTime? @map("published_at")
  publishAttempts    Int     @default(0) @map("publish_attempts")
  // L1.5 — tamper-evidence. HMAC(contentHash + sourceId) over rawPayload at ingest.
  sourceIntegrity    String? @map("source_integrity") @db.VarChar(64)
  // Tier 2 — sentiment + urgency enrichment, populated async after ingest.
  // Null until the analyzer has run. See sentimentService.
  sentimentScore       Decimal?  @map("sentiment_score") @db.Decimal(4, 3)
  urgencyScore         Decimal?  @map("urgency_score") @db.Decimal(4, 3)
  tone                 String?   @db.VarChar(30)
  sentimentRationale   String?   @map("sentiment_rationale") @db.Text
  sentimentAnalyzedAt  DateTime? @map("sentiment_analyzed_at")
  // MyOS — which user's connector produced this event. Nullable for legacy
  // rows written before the column existed; new ingests must stamp it.
  userId             Int?    @map("user_id")
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([clientNumber, contentHash])
  @@index([clientNumber, status])
  @@index([clientNumber, sourceType, createdAt])
  @@index([clientNumber, userId, sourceType, createdAt])
  @@index([clientNumber, eventType])
  @@index([clientNumber, senderEmail])
  @@index([clientNumber, publishedMessageId])
  @@map("feed_events")
}

// ─── M2: Agent Memory (cross-session state for ADK agents) ──────
model AgentMemory {
  id           String   @id @default(cuid())
  clientNumber String   @map("client_number") @db.VarChar(20)
  agentId      String   @map("agent_id") @db.VarChar(50) // brain | feed_curator | triage | action_executor | reflection | steering | shadow_scorer
  memoryKey    String   @map("memory_key") @db.VarChar(200)
  memoryValue  Json     @map("memory_value")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([clientNumber, agentId, memoryKey])
  @@index([expiresAt])
  @@map("agent_memory")
}

// ─── M3: Action Dependencies (cascading undo graph edges) ───────
model ActionDependency {
  id             Int      @id @default(autoincrement())
  clientNumber   String   @map("client_number") @db.VarChar(20)
  parentActionId Int      @map("parent_action_id") // FK → agent_actions.id
  childActionId  Int      @map("child_action_id")  // FK → agent_actions.id
  dependencyType String   @map("dependency_type") @db.VarChar(30) // triggers | blocks | informs | compensates
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([parentActionId, childActionId])
  @@index([clientNumber, parentActionId])
  @@index([childActionId])
  @@map("action_dependencies")
}

// ─── M4: Shadow Scores (Shadowing pipeline results) ─────────────
/**
 * ShadowRule — Probabilistic Shadowing rules. Mode: DRAFT → SHADOW → ACTIVE,
 * or FROZEN if the MD stops it. Evidence + agreement drive promotion prompts
 * surfaced in Day Brief.
 */
model ShadowRule {
  id                        String    @id @default(cuid())
  clientNumber              String    @map("client_number") @db.VarChar(20)
  userId                    Int?      @map("user_id")
  name                      String    @db.VarChar(200)
  description               String?
  archetype                 String?   @db.VarChar(30)
  triggerCondition          Json      @default("{}") @map("trigger_condition")
  action                    String    @db.VarChar(100)
  mode                      String    @default("DRAFT") @db.VarChar(20)
  evidence                  Int       @default(0)
  confirms                  Int       @default(0)
  overrides                 Int       @default(0)
  agreement                 Float?
  nextPromotionPromptAt     DateTime? @map("next_promotion_prompt_at")
  frozenReason              String?   @map("frozen_reason")
  metadata                  Json?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([clientNumber, mode])
  @@map("shadow_rules")
}

/**
 * TenantWhatsappNotifier — per-tenant outbound WhatsApp credentials.
 * Inbound is per-user (user_connectors); this is the sender used by Brain
 * when it needs to message users mid-day.
 */
model TenantWhatsappNotifier {
  clientNumber          String    @id @map("client_number") @db.VarChar(20)
  provider              String    @default("meta") @db.VarChar(20)
  displayNumber         String?   @map("display_number") @db.VarChar(30)
  phoneNumberId         String?   @map("phone_number_id") @db.VarChar(50)
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  appId                 String?   @map("app_id") @db.VarChar(100)
  wabaId                String?   @map("waba_id") @db.VarChar(100)
  isActive              Boolean   @default(false) @map("is_active")
  // Meta WhatsApp Business Calling — gated by enrollment per phone number.
  // Until admin flips this on, Brain emergency paths fall back to call-CTA.
  callingEnabled        Boolean   @default(false) @map("calling_enabled")
  callingApiUrl         String?   @map("calling_api_url") @db.VarChar(120)
  lastCallAt            DateTime? @map("last_call_at")
  lastCallError         String?   @map("last_call_error")
  verifiedAt            DateTime? @map("verified_at")
  lastSendAt            DateTime? @map("last_send_at")
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("tenant_whatsapp_notifier")
}

/**
 * BrainUserMessage — every proactive Brain → user contact (text / voice
 * note / WhatsApp call CTA / WhatsApp Business call). One row per send.
 *
 * Two functions:
 *   1) Audit panel — user/admin can see exactly when and why Brain pinged.
 *   2) Frequency cap — per-(user, kind, dedup_key) lookup gates duplicate
 *      sends across server restarts and replicas (in-process Maps lose this).
 */
model BrainUserMessage {
  id            BigInt   @id @default(autoincrement())
  clientNumber  String   @map("client_number") @db.VarChar(20)
  userId        Int      @map("user_id")
  kind          String   @db.VarChar(40)
  channel       String   @db.VarChar(20)
  urgency       String   @default("normal") @db.VarChar(10)
  summary       String
  waMessageIds  String[] @default([]) @map("wa_message_ids")
  dedupKey      String?  @map("dedup_key") @db.VarChar(120)
  status        String   @default("sent") @db.VarChar(20)
  error         String?
  toPhone       String?  @map("to_phone") @db.VarChar(30)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([clientNumber, createdAt(sort: Desc)])
  @@map("brain_user_messages")
}

/**
 * PatternInsight — Reflection agent writes an insight per pattern it notices.
 * Surfaced on Day Brief under "What I noticed overnight".
 */
model PatternInsight {
  id            Int       @id @default(autoincrement())
  clientNumber  String    @map("client_number") @db.VarChar(20)
  userId        Int?      @map("user_id")
  description   String
  evidenceCount Int       @default(1) @map("evidence_count")
  ruleDraftId   String?   @map("rule_draft_id") @db.VarChar(50)
  status        String    @default("new") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime? @map("expires_at")

  @@index([clientNumber, userId, createdAt])
  @@index([status, createdAt])
  @@map("pattern_insights")
}

model ShadowScore {
  id                String   @id @default(cuid())
  clientNumber      String   @map("client_number") @db.VarChar(20)
  modelVersion      String   @map("model_version") @db.VarChar(50)
  agentId           String   @map("agent_id") @db.VarChar(50)
  ruleId            String?  @map("rule_id")
  goldenDatasetId   String?  @map("golden_dataset_id")
  score             Float
  evaluationDetails Json     @map("evaluation_details")
  evaluatedAt       DateTime @default(now()) @map("evaluated_at")

  @@index([clientNumber, agentId, evaluatedAt])
  @@index([ruleId, evaluatedAt])
  @@map("shadow_scores")
}

// ─── M5: Golden Dataset (labeled historical decisions) ──────────
model GoldenDataset {
  id                 String   @id @default(cuid())
  clientNumber       String   @map("client_number") @db.VarChar(20)
  category           String   @db.VarChar(50) // action_type or archetype
  inputHash          String   @map("input_hash") @db.VarChar(64)
  inputText          String?  @map("input_text") @db.Text // small inputs only; large go to GCS
  expectedOutput     Json     @map("expected_output")
  scoreThreshold     Float    @map("score_threshold") // promotion gate (0.95 LOW, 0.98 MEDIUM)
  riskTier           String   @map("risk_tier") @db.VarChar(10) // LOW | MEDIUM | HIGH
  cloudStorageRef    String?  @map("cloud_storage_ref") @db.VarChar(500) // gs://bucket/path for large payloads
  lastEvaluatedAt    DateTime? @map("last_evaluated_at")
  curatedBy          Int?     @map("curated_by") // FK → User
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([clientNumber, inputHash])
  @@index([clientNumber, category, riskTier])
  @@map("golden_dataset")
}

// ─── M6: KPI Values (Steering Wheel time-series) ────────────────
model KpiValue {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  metricType   String   @map("metric_type") @db.VarChar(50)
  metricValue  Float    @map("metric_value")
  dimensions   Json?    // optional breakdown keys (by agent, by entity, etc.)
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  computedAt   DateTime @default(now()) @map("computed_at")

  @@index([clientNumber, metricType, periodStart])
  @@map("kpi_values")
}

// ─── M7: Agent Config Overrides (per-tenant customization) ──────
model AgentConfigOverride {
  id             Int      @id @default(autoincrement())
  clientNumber   String   @map("client_number") @db.VarChar(20)
  agentType      String   @map("agent_type") @db.VarChar(50)
  configKey      String   @map("config_key") @db.VarChar(100)
  configValue    Json     @map("config_value")
  overrideReason String?  @map("override_reason") @db.Text
  updatedBy      Int?     @map("updated_by") // FK → User
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([clientNumber, agentType, configKey])
  @@map("agent_config_overrides")
}

// ─── M8: Notification Queue (unified dispatch) ──────────────────
model NotificationQueue {
  id           Int      @id @default(autoincrement())
  clientNumber String   @map("client_number") @db.VarChar(20)
  recipientId  Int      @map("recipient_id") // FK → User
  channel      String   @db.VarChar(20) // email | whatsapp | in_app | chat
  payload      Json
  status       String   @default("pending") @db.VarChar(20) // pending | sending | sent | failed | cancelled
  retryCount   Int      @default(0) @map("retry_count")
  scheduledAt  DateTime @default(now()) @map("scheduled_at")
  sentAt       DateTime? @map("sent_at")
  failedAt     DateTime? @map("failed_at")
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientNumber, status, scheduledAt])
  @@index([recipientId])
  @@map("notification_queue")
}

// ─── M9: Action Undo Log (reverse-operation records) ────────────
model ActionUndoLog {
  id              Int      @id @default(autoincrement())
  clientNumber    String   @map("client_number") @db.VarChar(20)
  actionId        Int      @map("action_id") // FK → agent_actions.id
  reverseOperation Json    @map("reverse_operation") // what to call to undo
  diffSnapshot    Json?    @map("diff_snapshot") // pre/post state for audit
  executedBy      Int?     @map("executed_by") // FK → User (who triggered undo)
  undoneAt        DateTime? @map("undone_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([actionId])
  @@index([clientNumber, createdAt])
  @@map("action_undo_log")
}

// ─── M10: Rule Lifecycle (Shadowing state machine) ──────────────
model RuleLifecycle {
  id            String   @id @default(cuid())
  clientNumber  String   @map("client_number") @db.VarChar(20)
  ruleName      String   @map("rule_name") @db.VarChar(200)
  state         String   @default("DRAFT") @db.VarChar(20) // DRAFT | SHADOW | ACTIVE | DEPRECATED | ARCHIVED
  enteredAt     DateTime @default(now()) @map("entered_at")
  goldenScore   Float?   @map("golden_score") // most recent Golden Dataset score
  driftStd      Float?   @map("drift_std") // std dev shift over 7-day window
  frozen        Boolean  @default(false) // true = promotion blocked by drift guard
  frozenReason  String?  @map("frozen_reason") @db.Text
  ruleSpec      Json     @map("rule_spec") // rule definition (conditions, actions, thresholds)
  riskTier      String   @map("risk_tier") @db.VarChar(10) // LOW | MEDIUM | HIGH
  authorId      Int?     @map("author_id") // FK → User
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([clientNumber, ruleName])
  @@index([clientNumber, state])
  @@map("rule_lifecycle")
}
