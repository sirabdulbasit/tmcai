{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/scripts/smoke*.ts",
    "src/scripts/_smoke_undo.ts",
    "src/scripts/nexeoCapabilityBenchmark.ts",
    "src/scripts/brainChatRegressionBattery.ts",
    "src/scripts/brainChatBattery.ts",
    "src/scripts/cleanupBatterySeeds.ts",
    "src/scripts/seedGoldenDataset.ts",
    "src/scripts/verifyGuruFix.ts",
    "src/scripts/chaosDrill.ts",
    "src/scripts/loadTestFeed.ts",
    "src/scripts/draftTestWaToBasit.ts",
    "src/scripts/probeTasks.ts",
    "src/scripts/diagnoseAttention.ts",
    "src/scripts/scribeBackfillEmails.ts"
  ]
}
