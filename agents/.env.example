# HaseebOS v15 agent worker — copy to .env and fill in cowork-provided values.

GCP_PROJECT_ID=tmcai-491811
GCP_LOCATION=us-central1

# Platform API callback (Cloud Run internal URL or dev localhost).
# In production: the Platform Layer Cloud Run URL.
PLATFORM_API_URL=http://host.docker.internal:4002
# HMAC-signed service token the platform accepts for machine-to-machine auth.
# In production: pulled from Secret Manager `platform-api-token` via --set-secrets.
PLATFORM_API_TOKEN=

# Pub/Sub topics — must match server/src/config/pubsub.ts and cowork's actual GCP topics.
TOPIC_FEED_RAW=tmcai-feed-raw
TOPIC_OPENITEMS_SCORED=tmcai-openitems-scored
TOPIC_ACTIONS_APPROVED=tmcai-actions-approved
TOPIC_STEERING_SNAPSHOT=tmcai-steering-snapshot

# Push subscriptions (created via gcloud pubsub subscriptions create — see activation doc)
SUB_FEED_CURATOR=tmcai-feed-raw-sub
SUB_TRIAGE_ANALYST=tmcai-openitems-scored-sub
SUB_ACTION_EXECUTOR=tmcai-actions-approved-sub
SUB_STEERING_ANALYST=tmcai-steering-snapshot-sub

# Redis — using Ubuntu server's Redis (BullMQ approach, $0/mo).
# For production: point at Ubuntu server public IP; auth value comes from
# Secret Manager `memorystore-auth` secret via --set-secrets.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=

# Gemini models (via Vertex AI).
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
# Gemini API key — pulled from Secret Manager `tmcai-gemini-api-key` in prod.
GEMINI_API_KEY=

# External Knowledge APIs — TMC Context + KNOW
# Set these once Basit provides the base URLs and auth scheme.
# If left empty, the external_knowledge agent gracefully skips these sources.
TMC_CONTEXT_API_URL=
TMC_CONTEXT_API_KEY=
KNOW_API_URL=
KNOW_API_KEY=

# Agent identity (used in DecisionLog.agent_id and Pub/Sub attributes).
AGENT_ID=brain-orchestrator
